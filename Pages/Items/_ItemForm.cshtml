@model InvenTrack.Models.Item

<div asp-validation-summary="ModelOnly" class="mb-3"></div>

<div class="panel mb-4">
    <div class="panel-header"><h2>Details</h2></div>
    <div class="panel-body">
        <div class="row g-3">
            <div class="col-md-8">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" placeholder="e.g. M8 hex bolt (box of 100)" />
                <span asp-validation-for="Name"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Sku" class="form-label"></label>
                <input asp-for="Sku" class="form-control sku-input" placeholder="e.g. BLT-M8-100" />
                <span asp-validation-for="Sku"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Category" class="form-label"></label>
                <input asp-for="Category" class="form-control" placeholder="e.g. Fasteners" />
                <span asp-validation-for="Category"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Location" class="form-label"></label>
                <input asp-for="Location" class="form-control" placeholder="e.g. Aisle 1, Bay A" />
                <span asp-validation-for="Location"></span>
            </div>
        </div>
    </div>
</div>

<div class="panel mb-4">
    <div class="panel-header"><h2>Stock &amp; pricing</h2></div>
    <div class="panel-body">
        <div class="row g-3">
            <div class="col-md-4">
                <label asp-for="Quantity" class="form-label"></label>
                <input asp-for="Quantity" class="form-control" min="0" />
                <span asp-validation-for="Quantity"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="ReorderLevel" class="form-label"></label>
                <input asp-for="ReorderLevel" class="form-control" min="0" />
                <div class="form-text">Flagged as low stock at or below this.</div>
                <span asp-validation-for="ReorderLevel"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="UnitPrice" class="form-label"></label>
                <div class="input-group">
                    <span class="input-group-text">$</span>
                    <input asp-for="UnitPrice" type="number" step="0.01" min="0" class="form-control" />
                </div>
                <span asp-validation-for="UnitPrice"></span>
            </div>
        </div>
    </div>
</div>
