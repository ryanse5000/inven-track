@page
@model InvenTrack.Pages.Items.IndexModel
@{
    ViewData["Title"] = "Items";
    var filtered = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrEmpty(Model.Category) || Model.LowStockOnly;
}

<div class="page-header">
    <div>
        <h1>Items</h1>
        <p>@Model.Items.Count @(Model.Items.Count == 1 ? "item" : "items")@(filtered ? " matching your filters" : " in stock list")</p>
    </div>
    <a asp-page="Create" class="btn btn-primary">@Icon.Get("plus", 16) Add item</a>
</div>

<div class="panel">
    <form method="get" class="panel-header flex-wrap" data-auto-submit>
        <div class="search flex-grow-1" style="min-width:220px;max-width:420px">
            @Icon.Get("search", 16)
            <input asp-for="Search" class="form-control" placeholder="Search name or SKU…" type="search" />
        </div>
        <div class="d-flex flex-wrap align-items-center gap-3">
            <select asp-for="Category" class="form-select" style="width:auto">
                <option value="">All categories</option>
                @foreach (var c in Model.Categories)
                {
                    <option value="@c">@c</option>
                }
            </select>
            <div class="form-check form-switch m-0">
                <input asp-for="LowStockOnly" class="form-check-input" role="switch" />
                <label asp-for="LowStockOnly" class="form-check-label">Low stock only</label>
            </div>
            @if (filtered)
            {
                <a asp-page="Index" class="small fw-medium">Clear</a>
            }
            <noscript><button type="submit" class="btn btn-light btn-sm">Filter</button></noscript>
        </div>
    </form>

    @if (Model.Items.Count == 0)
    {
        <div class="empty">
            <span class="chip chip-primary">@Icon.Get("inbox", 22)</span>
            @(filtered ? "No items match your filters." : "No items yet. Add your first one to get started.")
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th style="min-width:180px">Item</th>
                        <th class="d-none d-md-table-cell">Category</th>
                        <th class="d-none d-lg-table-cell">Location</th>
                        <th>Status</th>
                        <th class="num">Qty</th>
                        <th class="num">Unit price</th>
                        <th class="num">Value</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td>
                                <a asp-page="Details" asp-route-id="@item.Id" class="item-name">@item.Name</a>
                                <div class="sku">@item.Sku</div>
                            </td>
                            <td class="d-none d-md-table-cell">
                                @if (item.Category is not null)
                                {
                                    <span class="tag">@item.Category</span>
                                }
                            </td>
                            <td class="text-muted text-nowrap d-none d-lg-table-cell">@item.Location</td>
                            <td><partial name="_StockStatus" model="item" /></td>
                            <td class="num fw-semibold">@item.Quantity</td>
                            <td class="num">@item.UnitPrice.ToString("C")</td>
                            <td class="num">@item.StockValue.ToString("C")</td>
                            <td class="text-end text-nowrap">
                                <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-icon" title="Edit" aria-label="Edit @item.Name">@Icon.Get("pencil", 16)</a>
                                <a asp-page="Delete" asp-route-id="@item.Id" class="btn btn-icon danger" title="Delete" aria-label="Delete @item.Name">@Icon.Get("trash", 16)</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
