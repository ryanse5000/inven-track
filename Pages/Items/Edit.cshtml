@page "{id:int}"
@model InvenTrack.Pages.Items.EditModel
@{
    ViewData["Title"] = "Edit item";
}

<div style="max-width:880px">
    <a asp-page="Details" asp-route-id="@Model.Item.Id" class="back-link">@Icon.Get("arrow-left", 16) Back to item</a>

    <div class="page-header">
        <div>
            <h1>Edit item</h1>
            <p>Changing the quantity here adds an entry to the stock history.</p>
        </div>
    </div>

    <form method="post">
        <partial name="_ItemForm" for="Item" />
        <div class="d-flex justify-content-end gap-2">
            <a asp-page="Details" asp-route-id="@Model.Item.Id" class="btn btn-light">Cancel</a>
            <button type="submit" class="btn btn-primary">Save changes</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
